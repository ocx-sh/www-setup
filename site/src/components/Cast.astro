---
// One recorded terminal cast, `/casts/<name>.cast`, or nothing while that file does not exist. `task site:casts`
// records the casts into the repository (committed, DOC-EX-13: no build step regenerates them); a missing cast
// renders no player rather than a broken one, and never a hand-typed stand-in (DOC-EX-12).
import { existsSync } from 'node:fs';
import { publicDir } from 'astro:config/server';
import Terminal from '@ocx-sh/theme/components/Terminal.astro';

interface Props {
  /** Cast key, `<group>/<slug>`: the script `casts/<group>__<slug>.sh` records `public/casts/<group>/<slug>.cast`. */
  name: string;
  title: string;
}

const { name, title } = Astro.props;
const recorded = existsSync(new URL(`casts/${name}.cast`, publicDir));
---

{recorded && <Terminal src={`/casts/${name}.cast`} title={title} />}
